ENV/
env/
backend/venv/
backend/venv*/
backend/.venv/
backend/.venv-ci/
backend/.venv-ci*/
.setup-stamp.json
*.egg-info/
dist/
build/
.pytest_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend build
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.db-shm
*.db-wal
data/
backend/.runtime/

# Force-include shipped SDK baseline data (refreshed by
# scripts/refresh_category_yes_rates.py; the seed is the empirical
# baseline at commit time so a fresh install has reasonable defaults).
!backend/data/
!backend/data/*.json
# The data/ pattern above (no leading slash) matches ANY directory named
# "data" at any depth — keep the EvoSport Python package and the frontend
# static data whitelisted so they are never dropped from delivery.
!backend/evosport/data/
!backend/evosport/data/**
!frontend/src/data/
!frontend/src/data/**
!frontend/public/data/
!frontend/public/data/**

# Local exports
homerun-settings-*.json

# Logs
*.log
logs/

# Runtime artifacts
*.rdb

# Test / debug artifacts
output/
.playwright-cli/
.oneshot/
# Backtest-runner JSON dumps from scripts/ — operator regenerates
# at will; never read by live runtime.
backend/scripts/_*_results*.json

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Windows reserved-name artifact
/nul

# Secrets
.env
.env.local
.env.*.local
secrets.json
.claude/worktrees/
.worktrees/
.superpowers/sdd/
.cutover-snapshots/

# EvoSport publish hygiene — local scan/runtime artifacts never published
backend/evosport_market_scan.*
backend/evosport_polymarket_prediction_table.md
backend/evosport_market_snapshot.json
backend/data/cache/
backend/scripts/evosport_market_scan.py
